{
  "name": "live-captions",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @live-captions/api --filter @live-captions/web --parallel run dev",
    "dev:network": "pnpm --filter @live-captions/api --filter @live-captions/web --parallel run dev:network",
    "build": "pnpm -r run build",
    "build:prod": "pnpm --filter @live-captions/contracts build && pnpm --filter @live-captions/config build && pnpm --filter @live-captions/ui build && pnpm --filter @live-captions/web build && pnpm --filter @live-captions/api build",
    "start": "node apps/api/dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.2",
    "vitest": "^2.1.8"
  },
  "packageManager": "pnpm@10.33.0+sha512.10568bb4a6afb58c9eb3630da90cc9516417abebd3fabbe6739f0ae795728da1491e9db5a544c76ad8eb7570f5c4bb3d6c637b2cb41bfdcdb47fa823c8649319"
}
